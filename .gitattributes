* text=auto
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.pdf binary
*.docx binary

# Corpus hashes cover upstream bytes, including Gutenberg CRLF and source whitespace.
# Keep the reviewed originals, licenses and exact extraction offsets stable on checkout.
data/week03/cross-domain/** -text -whitespace

# Keep native database/PDF hashes and imported Patchouli source bytes intact.
apps/week04/src/assets/seed/*.sqlite binary
apps/week04/src/assets/seed/pdfs/*.pdf binary
apps/week04/vendor/patchouli/** -text -whitespace
